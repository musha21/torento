# TORENTO — Supabase (required for auth, bookings, admin)
# Create a project at https://supabase.com then paste values from Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_7jgeD24sbWogqnTww3tHqA_t9Vjunxn

# Public site URL — use your live domain in production (canonicals + sitemap).
# Localhost is ignored for SEO canonicals; sitemap falls back to https://torento.lk
VITE_SITE_URL=https://torento.lk
# Optional alias for build-time sitemap generation
# VITE_PUBLIC_SITE_URL=https://torento.lk

# WhatsApp business number (digits only, country code, no +)
VITE_WHATSAPP_NUMBER=94777666171

# NEVER put SUPABASE_SERVICE_ROLE_KEY in Vite env (VITE_* is exposed to the browser).
# Use the service role only in the Supabase SQL Editor / server scripts.
